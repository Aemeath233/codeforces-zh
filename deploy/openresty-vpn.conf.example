# Use an address assigned to the server's WireGuard interface, never 0.0.0.0.
# WireGuard supplies encryption and peer authentication; this entry needs no
# domain, certificate or additional browser password. Only trusted VPN peers
# should be allowed. The backend continues listening on localhost.
server {
    listen 10.77.0.1:18780;
    server_name 10.77.0.1;
    if ($host != 10.77.0.1) { return 403; }
    allow 10.77.0.0/24;
    deny all;
    client_max_body_size 2m;
    auth_basic off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location / {
        proxy_pass http://127.0.0.1:18780;
        proxy_set_header Host 127.0.0.1:18780;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 180s;
    }
}
